element FabricGrid:
	has color with Color(#e6b94a)
	has initialized with false
	has root with null
	has local_x with 0
	has local_y with 0
	has quiet_ticks with 0
	has build_age with 0

	has function is_node_column needs value Number:
		if value equals 0 - 22:
			give true
		if value equals 0 - 11:
			give true
		if value equals 0:
			give true
		if value equals 11:
			give true
		give value equals 22

	has function is_node_row needs value Number:
		if value equals 0:
			give true
		if value equals 11:
			give true
		if value equals 22:
			give true
		give value equals 33

	has function is_horizontal_node_x needs value Number:
		if value equals 0 - 22:
			give true
		if value equals 0 - 18:
			give true
		if value equals 0 - 15:
			give true
		if value equals 0 - 11:
			give true
		if value equals 0 - 7:
			give true
		if value equals 0 - 4:
			give true
		if value equals 0:
			give true
		if value equals 4:
			give true
		if value equals 7:
			give true
		if value equals 11:
			give true
		if value equals 15:
			give true
		if value equals 18:
			give true
		give value equals 22

	has function is_vertical_node_y needs value Number:
		if value equals 0:
			give true
		if value equals 4:
			give true
		if value equals 7:
			give true
		if value equals 11:
			give true
		if value equals 15:
			give true
		if value equals 18:
			give true
		if value equals 22:
			give true
		if value equals 26:
			give true
		if value equals 29:
			give true
		give value equals 33

	has function is_node needs node_x Number node_y Number:
		if is_node_row(node_y):
			if is_horizontal_node_x(node_x):
				give true
		if is_node_column(node_x):
			if is_vertical_node_y(node_y):
				give true
		give false

	has function initial_sag needs node_x Number:
		if node_x equals 0 - 22:
			give 0
		if node_x equals 22:
			give 0
		if node_x equals 0 - 18:
			give 3
		if node_x equals 18:
			give 3
		if node_x equals 0 - 15:
			give 5
		if node_x equals 15:
			give 5
		if node_x equals 0 - 11:
			give 7
		if node_x equals 11:
			give 7
		if node_x equals 0 - 7:
			give 9
		if node_x equals 7:
			give 9
		if node_x equals 0 - 4:
			give 10
		if node_x equals 4:
			give 10
		give 11

	has function configure_builder needs piece FabricGrid piece_x Number piece_y Number:
		let piece.initialized be true
		let piece.root be root
		let piece.local_x be piece_x
		let piece.local_y be piece_y

	has function grow_grid:
		let old_up be get_element_at(position_x, position_y - 1)
		let old_down be get_element_at(position_x, position_y + 1)
		let old_left be get_element_at(position_x - 1, position_y)
		let old_right be get_element_at(position_x + 1, position_y)
		spread_element()
		let new_up be get_element_at(position_x, position_y - 1)
		let new_down be get_element_at(position_x, position_y + 1)
		let new_left be get_element_at(position_x - 1, position_y)
		let new_right be get_element_at(position_x + 1, position_y)

		if old_up equals null:
			if new_up is FabricGrid:
				let next_y be local_y - 1
				if next_y less_than 0:
					new_up.disappear()
				else:
					configure_builder(new_up, local_x, next_y)

		if old_down equals null:
			if new_down is FabricGrid:
				let next_y be local_y + 1
				if next_y greater_than 33:
					new_down.disappear()
				else:
					configure_builder(new_down, local_x, next_y)

		if old_left equals null:
			if new_left is FabricGrid:
				let next_x be local_x - 1
				if next_x less_than 0 - 22:
					new_left.disappear()
				else:
					configure_builder(new_left, next_x, local_y)

		if old_right equals null:
			if new_right is FabricGrid:
				let next_x be local_x + 1
				if next_x greater_than 22:
					new_right.disappear()
				else:
					configure_builder(new_right, next_x, local_y)

	has function finish_piece needs piece FabricGrid mesh_owner Element:
		let piece_x be piece.local_x
		let piece_y be piece.local_y
		if is_node(piece_x, piece_y):
			piece.convert_to(Fabric)
			let piece.mesh be mesh_owner
			let piece.grid_x be piece_x
			let piece.grid_y be piece_y
			let piece.position_y be piece.position_y + initial_sag(piece_x)
			if piece_y equals 0:
				if piece_x equals 0 - 22:
					let piece.anchored be true
				if piece_x equals 22:
					let piece.anchored be true
		else:
			piece.disappear()

	has function finish_grid:
		let mesh_owner be root
		for_every piece in get_all_elements():
			if piece is FabricGrid:
				if piece.root equals mesh_owner:
					if not (piece equals mesh_owner):
						finish_piece(piece, mesh_owner)

		let center_x be local_x
		let center_y be local_y
		convert_to(Fabric)
		let mesh be mesh_owner
		let grid_x be center_x
		let grid_y be center_y
		let controller be true
		let position_y be position_y + initial_sag(center_x)

	has function tick:
		if initialized:
			grow_grid()
			if root equals get_element_at(position_x, position_y):
				let build_age be build_age + 1
			if build_age greater_than 56:
					finish_grid()
			give null

		for_every existing in get_all_elements():
			if existing is Fabric:
				if existing.controller:
					disappear()
					give null

		let saw_other_seed be false
		for_every candidate in get_all_elements():
			if candidate is FabricGrid:
				if not candidate.initialized:
					if not (candidate equals get_element_at(position_x, position_y)):
						if candidate.position_x less_than position_x:
							disappear()
							give null
						if candidate.position_x equals position_x:
							if candidate.position_y less_than position_y:
								disappear()
								give null
						let saw_other_seed be true

		if saw_other_seed:
			let quiet_ticks be 0
			give null

		let quiet_ticks be quiet_ticks + 1
		if quiet_ticks less_than 3:
			give null

		let initialized be true
		let root be get_element_at(position_x, position_y)
		let build_age be 0
		grow_grid()

element Fabric:
	has color with Color(#e6b94a)
	has mesh with null
	has grid_x with 0
	has grid_y with 0
	has anchored with false
	has controller with false
	has render_only with false
	has owner with null
	has target with null
	has initialized with false
	has cut with false
	has right_link with null
	has down_link with null
	has down_right_link with null
	has down_left_link with null
	has right_broken with false
	has down_broken with false
	has down_right_broken with false
	has down_left_broken with false
	has velocity_x with 0
	has velocity_y with 0
	has motion_x with 0
	has motion_y with 0
	has right_stress with 0
	has down_stress with 0
	has down_right_stress with 0
	has down_left_stress with 0
	has active_ticks with 45

	has function absolute needs value Number:
		if value less_than 0:
			give 0 - value
		give value

	has function next_horizontal_x:
		if grid_x equals 0 - 22:
			give 0 - 18
		if grid_x equals 0 - 18:
			give 0 - 15
		if grid_x equals 0 - 15:
			give 0 - 11
		if grid_x equals 0 - 11:
			give 0 - 7
		if grid_x equals 0 - 7:
			give 0 - 4
		if grid_x equals 0 - 4:
			give 0
		if grid_x equals 0:
			give 4
		if grid_x equals 4:
			give 7
		if grid_x equals 7:
			give 11
		if grid_x equals 11:
			give 15
		if grid_x equals 15:
			give 18
		if grid_x equals 18:
			give 22
		give 1000

	has function next_vertical_y:
		if grid_y equals 0:
			give 4
		if grid_y equals 4:
			give 7
		if grid_y equals 7:
			give 11
		if grid_y equals 11:
			give 15
		if grid_y equals 15:
			give 18
		if grid_y equals 18:
			give 22
		if grid_y equals 22:
			give 26
		if grid_y equals 26:
			give 29
		if grid_y equals 29:
			give 33
		give 1000

	has function next_column_x:
		if grid_x equals 0 - 22:
			give 0 - 11
		if grid_x equals 0 - 11:
			give 0
		if grid_x equals 0:
			give 11
		if grid_x equals 11:
			give 22
		give 1000

	has function previous_column_x:
		if grid_x equals 22:
			give 11
		if grid_x equals 11:
			give 0
		if grid_x equals 0:
			give 0 - 11
		if grid_x equals 0 - 11:
			give 0 - 22
		give 1000

	has function next_row_y:
		if grid_y equals 0:
			give 11
		if grid_y equals 11:
			give 22
		if grid_y equals 22:
			give 33
		give 1000

	has function bind_links:
		let wanted_right_x be next_horizontal_x()
		let wanted_down_y be next_vertical_y()
		let wanted_diagonal_y be next_row_y()
		let wanted_down_right_x be next_column_x()
		let wanted_down_left_x be previous_column_x()
		for_every candidate in get_all_elements():
			if candidate is Fabric:
				if not candidate.render_only:
					if candidate.mesh equals mesh:
						if candidate.grid_y equals grid_y:
							if candidate.grid_x equals wanted_right_x:
								let right_link be candidate
						if candidate.grid_x equals grid_x:
							if candidate.grid_y equals wanted_down_y:
								let down_link be candidate
						if candidate.grid_y equals wanted_diagonal_y:
							if candidate.grid_x equals wanted_down_right_x:
								let down_right_link be candidate
							if candidate.grid_x equals wanted_down_left_x:
								let down_left_link be candidate
		let initialized be true

	has function break_node:
		wake_mesh()
		let cut be true
		let color be Color(#ffffff)
		let velocity_x be 0
		let velocity_y be 0
		let motion_x be 0
		let motion_y be 0

	has function break_link needs target Fabric:
		wake_mesh()
		if right_link is Fabric:
			if right_link equals target:
				let right_broken be true
				give null
		if down_link is Fabric:
			if down_link equals target:
				let down_broken be true
				give null
		if down_right_link is Fabric:
			if down_right_link equals target:
				let down_right_broken be true
				give null
		if down_left_link is Fabric:
			if down_left_link equals target:
				let down_left_broken be true

	has function add_force needs force_x Number force_y Number:
		if anchored:
			give null
		if cut:
			give null
		let velocity_x be velocity_x + force_x
		let velocity_y be velocity_y + force_y

	has function wake_mesh:
		if mesh is Fabric:
			let mesh.active_ticks be 80

	has function prepare_physics:
		if anchored:
			let velocity_x be 0
			let velocity_y be 0
			let motion_x be 0
			let motion_y be 0
			give null
		if cut:
			give null

		let velocity_x be velocity_x * 0.25
		let velocity_y be velocity_y * 0.25 + 0.05
		if velocity_x greater_than 1.5:
			let velocity_x be 1.5
		else if velocity_x less_than 0 - 1.5:
			let velocity_x be 0 - 1.5
		if velocity_y greater_than 1.5:
			let velocity_y be 1.5
		else if velocity_y less_than 0 - 1.5:
			let velocity_y be 0 - 1.5

	has function approximate_distance needs difference_x Number difference_y Number:
		let distance_x be absolute(difference_x)
		let distance_y be absolute(difference_y)
		let longest be distance_x
		let shortest be distance_y
		if distance_y greater_than distance_x:
			let longest be distance_y
			let shortest be distance_x
		give longest + shortest * 0.4

	has function spring_force needs target Fabric rest_length Number stiffness Number:
		if target.cut:
			give 0
		let difference_x be target.position_x - position_x
		let difference_y be target.position_y - position_y
		let distance be approximate_distance(difference_x, difference_y)
		if distance less_than 0.1:
			give 0

		let stretch be distance - rest_length
		let force be stretch * stiffness
		if stretch less_than 0:
			let force be stretch * stiffness * 0.35
		if force greater_than 0.7:
			let force be 0.7
		else if force less_than 0 - 0.25:
			let force be 0 - 0.25
		let force_x be difference_x / distance * force
		let force_y be difference_y / distance * force
		add_force(force_x, force_y)
		target.add_force(0 - force_x, 0 - force_y)
		give absolute(stretch)

	has function apply_springs:
		if cut:
			give null
		if right_link is Fabric:
			if not right_broken:
				let right_rest_length be absolute(right_link.grid_x - grid_x)
				spring_force(right_link, right_rest_length, 0.5)

		if down_link is Fabric:
			if not down_broken:
				let down_rest_length be absolute(down_link.grid_y - grid_y)
				spring_force(down_link, down_rest_length, 0.75)

		if down_right_link is Fabric:
			if not down_right_broken:
				spring_force(down_right_link, 15.4, 0.3)

		if down_left_link is Fabric:
			if not down_left_broken:
				spring_force(down_left_link, 15.4, 0.3)

	has function apply_pull_damage needs amount Number:
		if right_link is Fabric:
			if not right_broken:
				let right_stress be right_stress + amount
				if right_stress greater_than 20:
					let right_broken be true
		if down_link is Fabric:
			if not down_broken:
				let down_stress be down_stress + amount
				if down_stress greater_than 20:
					let down_broken be true
		if down_right_link is Fabric:
			if not down_right_broken:
				let down_right_stress be down_right_stress + amount
				if down_right_stress greater_than 20:
					let down_right_broken be true
		if down_left_link is Fabric:
			if not down_left_broken:
				let down_left_stress be down_left_stress + amount
				if down_left_stress greater_than 20:
					let down_left_broken be true

	has function move_horizontal:
		if motion_x greater_than 0.8:
			if position_x less_than 126:
				let old_x be position_x
				let position_x be position_x + 1
				if position_x greater_than old_x:
					let motion_x be motion_x - 1
				else:
					let velocity_x be 0 - velocity_x * 0.2
		else if motion_x less_than 0 - 0.8:
			if position_x greater_than 1:
				let old_x be position_x
				let position_x be position_x - 1
				if position_x less_than old_x:
					let motion_x be motion_x + 1
				else:
					let velocity_x be 0 - velocity_x * 0.2

	has function move_vertical:
		if motion_y greater_than 0.8:
			if position_y less_than 126:
				let old_y be position_y
				let position_y be position_y + 1
				if position_y greater_than old_y:
					let motion_y be motion_y - 1
				else:
					let velocity_y be 0 - velocity_y * 0.15
		else if motion_y less_than 0 - 0.8:
			if position_y greater_than 1:
				let old_y be position_y
				let position_y be position_y - 1
				if position_y less_than old_y:
					let motion_y be motion_y + 1
				else:
					let velocity_y be 0 - velocity_y * 0.15

	has function advance:
		if anchored:
			give null
		if cut:
			give null
		let motion_x be motion_x + velocity_x
		let motion_y be motion_y + velocity_y
		move_horizontal()
		move_vertical()

	has function clear_pixels:
		for_every item in get_all_elements():
			if item is Fabric:
				if item.mesh equals mesh:
					if item.render_only:
						item.disappear()

	has function clean_spawn needs candidate Element keep Element:
		if candidate is Fabric:
			if candidate.mesh equals null:
				if not (candidate equals keep):
					candidate.disappear()

	has function seed_pixel needs target Fabric:
		let difference_x be target.position_x - position_x
		let difference_y be target.position_y - position_y
		let distance_x be absolute(difference_x)
		let distance_y be absolute(difference_y)
		let next_x be position_x
		let next_y be position_y
		if distance_x greater_than distance_y:
			if difference_x greater_than 0:
				let next_x be position_x + 1
			else:
				let next_x be position_x - 1
		else:
			if difference_y greater_than 0:
				let next_y be position_y + 1
			else:
				let next_y be position_y - 1

		if next_x equals target.position_x:
			if next_y equals target.position_y:
				give null
		if not (get_element_at(next_x, next_y) equals null):
			give null

		spread_element()
		let seed be get_element_at(next_x, next_y)
		let up be get_element_at(position_x, position_y - 1)
		let down be get_element_at(position_x, position_y + 1)
		let left be get_element_at(position_x - 1, position_y)
		let right be get_element_at(position_x + 1, position_y)
		if seed is Fabric:
			if seed.mesh equals null:
				let seed.mesh be mesh
				let seed.render_only be true
				let seed.owner be get_element_at(position_x, position_y)
				let seed.target be target
		clean_spawn(up, seed)
		clean_spawn(down, seed)
		clean_spawn(left, seed)
		clean_spawn(right, seed)
		if seed is Fabric:
			seed.extend_pixel()

	has function extend_pixel:
		if not render_only:
			give null
		if not (target is Fabric):
			give null
		let difference_x be target.position_x - position_x
		let difference_y be target.position_y - position_y
		let distance_x be absolute(difference_x)
		let distance_y be absolute(difference_y)
		if distance_x + distance_y less_than 2:
			give null

		let next_x be position_x
		let next_y be position_y
		if distance_x greater_than distance_y:
			if difference_x greater_than 0:
				let next_x be position_x + 1
			else:
				let next_x be position_x - 1
		else:
			if difference_y greater_than 0:
				let next_y be position_y + 1
			else:
				let next_y be position_y - 1

		if not (get_element_at(next_x, next_y) equals null):
			give null
		spread_element()
		let next_pixel be get_element_at(next_x, next_y)
		let up be get_element_at(position_x, position_y - 1)
		let down be get_element_at(position_x, position_y + 1)
		let left be get_element_at(position_x - 1, position_y)
		let right be get_element_at(position_x + 1, position_y)
		if next_pixel is Fabric:
			if next_pixel.mesh equals null:
				let next_pixel.mesh be mesh
				let next_pixel.render_only be true
				let next_pixel.owner be owner
				let next_pixel.target be target
		clean_spawn(up, next_pixel)
		clean_spawn(down, next_pixel)
		clean_spawn(left, next_pixel)
		clean_spawn(right, next_pixel)
		if next_pixel is Fabric:
			next_pixel.extend_pixel()

	has function cut_rope:
		if render_only:
			if owner is Fabric:
				if target is Fabric:
					owner.break_link(target)

	has function render_links:
		if cut:
			give null
		if right_link is Fabric:
			if not right_broken:
					if not right_link.cut:
						seed_pixel(right_link)
		if down_link is Fabric:
			if not down_broken:
					if not down_link.cut:
						seed_pixel(down_link)

	has function simulate_mesh:
		clear_pixels()
		for_every node in get_all_elements():
			if node is Fabric:
				if not node.render_only:
					if node.mesh equals mesh:
						if not node.initialized:
							node.bind_links()
		for_every node in get_all_elements():
			if node is Fabric:
				if not node.render_only:
					if node.mesh equals mesh:
						node.prepare_physics()
		for_every node in get_all_elements():
			if node is Fabric:
				if not node.render_only:
					if node.mesh equals mesh:
						node.apply_springs()
		for_every node in get_all_elements():
			if node is Fabric:
				if not node.render_only:
					if node.mesh equals mesh:
						node.advance()
		for_every node in get_all_elements():
			if node is Fabric:
				if not node.render_only:
					if node.mesh equals mesh:
						node.render_links()

	has function is_duplicate_controller:
		let current be get_element_at(position_x, position_y)
		for_every candidate in get_all_elements():
			if candidate is Fabric:
				if candidate.controller:
					if not (candidate equals current):
						if candidate.position_x less_than position_x:
							give true
						if candidate.position_x equals position_x:
							if candidate.position_y less_than position_y:
								give true
		give false

	has function remove_mesh:
		let current be get_element_at(position_x, position_y)
		for_every item in get_all_elements():
			if item is Fabric:
				if item.mesh equals mesh:
					if not (item equals current):
						item.disappear()
		disappear()

	has function tick:
		if mesh equals null:
			disappear()
			give null
		if controller:
			if is_duplicate_controller():
				remove_mesh()
				give null
			if active_ticks greater_than 0:
				simulate_mesh()
				let active_ticks be active_ticks - 1

element Scissors:
	has color with Color(#9aa0a6)
	has lifetime with 3

	has function cut_nearby:
		go_through 0 to 6 with column:
			go_through 0 to 6 with row:
				let target_x be position_x + column - 3
				let target_y be position_y + row - 3
				let target be get_element_at(target_x, target_y)
				if target is Fabric:
					if target.render_only:
						target.cut_rope()
					else:
						target.break_node()

	has function tick:
		cut_nearby()
		let lifetime be lifetime - 1
		if lifetime less_than 1:
			disappear()

element Pull:
	has color with Color(#e74c3c)
	has attached with null
	has fall_tick with 0
	has pull_age with 0
	has start_y with 0
	has released with false

	has function attach_to_nearby:
		go_through 0 to 6 with column:
			go_through 0 to 6 with row:
				let target_x be position_x + column - 3
				let target_y be position_y + row - 3
				let target be get_element_at(target_x, target_y)
				if target is Fabric:
					if target.render_only:
						if target.owner is Fabric:
							let attached be target.owner
							let start_y be position_y
							let pull_age be 0
							give true
					else if not target.cut:
						let attached be target
						let start_y be position_y
						let pull_age be 0
						give true
		give false

	has function fall:
		let below be get_element_at(position_x, position_y + 1)
		if below equals null:
			let position_y be position_y + 1

	has function pull_node needs target Fabric:
		target.wake_mesh()
		let difference_x be position_x - target.position_x
		let difference_y be position_y - target.position_y
		let force_x be difference_x * 0.008
		let force_y be 0.04 + difference_y * 0.012
		if force_x greater_than 0.08:
			let force_x be 0.08
		else if force_x less_than 0 - 0.08:
			let force_x be 0 - 0.08
		if force_y greater_than 0.16:
			let force_y be 0.16
		else if force_y less_than 0 - 0.08:
			let force_y be 0 - 0.08
		target.add_force(force_x, force_y)
		let vertical_distance be difference_y
		if vertical_distance less_than 0:
			let vertical_distance be 0 - vertical_distance
		let pull_age be pull_age + 1
		if vertical_distance greater_than 14:
			target.break_node()
			let attached be null
			let released be true
			give null
		if pull_age greater_than 300:
			target.break_node()
			let attached be null
			let released be true
			give null
		if vertical_distance greater_than 8:
			target.apply_pull_damage((vertical_distance - 8) * 0.01)
		let fall_tick be fall_tick + 1
		if position_y less_than start_y + 12:
			if fall_tick greater_than 3:
				let fall_tick be 0
				fall()

	has function tick:
		if released:
			fall()
			give null
		if attached is Fabric:
			if attached.cut:
				let attached be null
				let released be true
			else:
				pull_node(attached)
				give null
		if attach_to_nearby():
			give null
		fall()

element Stone:
	has color with Color(#686b70)
