		if target_x greater_than 127:
			give false

		if target_y less_than 0:
			give false

		if target_y greater_than 127:
			give false

		let relative_x be target_x - position_x
		let relative_y be target_y - position_y

		if is_inside_shape(relative_x, relative_y, rotation):
			give false

		let destination be get_element_at(target_x, target_y)

		if not (destination equals null):
			give false

		let target.position_x be target_x
		let target.position_y be target_y

		if not (target.position_x equals target_x):
			give false

		if not (target.position_y equals target_y):
			give false

		let target.velocity_x be velocity_x * 0.35 + direction_x * 0.45
		let target.velocity_y be velocity_y * 0.15
		let target.airborne be true
		give true

	has function compact_water_into needs target Water container Water:
		if target equals container:
			give false

		let relative_x be container.position_x - position_x
		let relative_y be container.position_y - position_y

		if is_inside_shape(relative_x, relative_y, rotation):
			give false

		let container.compressed be container.compressed + target.compressed
		target.disappear()
		give true

	has function compact_water needs target Water push_direction Number:
		let first_side be get_element_at(position_x + push_direction * 8, target.position_y)

		if first_side is Water:
			if compact_water_into(target, first_side):
				give true

		let other_side be get_element_at(position_x - push_direction * 8, target.position_y)

		if other_side is Water:
			if compact_water_into(target, other_side):
				give true

		let upper_water be get_element_at(target.position_x, position_y - 8)

		if upper_water is Water:
			if compact_water_into(target, upper_water):
				give true

		let wider_side be get_element_at(position_x + push_direction * 9, target.position_y)

		if wider_side is Water:
			if compact_water_into(target, wider_side):
				give true

		let wider_other_side be get_element_at(position_x - push_direction * 9, target.position_y)

		if wider_other_side is Water:
			if compact_water_into(target, wider_other_side):
				give true

		give false

	has function displace_water needs target Water:
		let center be find_center()

		if not (center is Square):
			give false

		let push_direction be center.roll_direction

		if target.position_x less_than center.position_x:
			let push_direction be 0 - 1
		else if target.position_x greater_than center.position_x:
			let push_direction be 1

		let horizontal_speed be absolute(center.velocity_x)
		let vertical_speed be absolute(center.velocity_y)

		if horizontal_speed less_than 0.15:
			if vertical_speed less_than 0.15:
				if center.compact_water(target, push_direction):
					give true

		if center.move_water_to(target, center.position_x + push_direction * 8, target.position_y, push_direction):
			give true

		if center.move_water_to(target, center.position_x - push_direction * 8, target.position_y, 0 - push_direction):
			give true

		if center.move_water_to(target, center.position_x + push_direction * 9, target.position_y, push_direction):
			give true

		if center.move_water_to(target, center.position_x - push_direction * 9, target.position_y, 0 - push_direction):
			give true

		if center.move_water_to(target, center.position_x + push_direction * 10, target.position_y, push_direction):
			give true

		if center.move_water_to(target, center.position_x - push_direction * 10, target.position_y, 0 - push_direction):
			give true

		let mirrored_x be center.position_x * 2 - target.position_x
		let mirrored_y be center.position_y * 2 - target.position_y

		if center.move_water_to(target, mirrored_x, mirrored_y, 0 - push_direction):
			give true

		give center.compact_water(target, push_direction)

	has function displace_sand needs target Sand:
		let center be find_center()

		if not (center is Square):
			give null

		let horizontal_speed be absolute(center.collision_velocity_x)
		let vertical_speed be absolute(center.collision_velocity_y)

		if horizontal_speed less_than 1.1:
			if vertical_speed less_than 1.1:
				give null

		if center.sand_supporting:
			if center.is_supporting_sand(target):
				give null

		let push_direction be center.roll_direction

		if target.position_x less_than center.position_x:
			let push_direction be 0 - 1
		else if target.position_x greater_than center.position_x:
			let push_direction be 1

		let side be get_element_at(target.position_x + push_direction, target.position_y)
		let horizontal_transfer be center.velocity_x * 0.7
		let vertical_transfer be center.velocity_y * 0.6
		let outward_force be absolute(center.velocity_y) * 0.35 + 1
		let upward_force be absolute(center.velocity_y) * 0.45 + 0.8

		if side equals null:
			let target.position_x be target.position_x + push_direction
			let target.velocity_x be horizontal_transfer + push_direction * outward_force

			if vertical_transfer less_than 0:
				let target.velocity_y be vertical_transfer
			else:
				let target.velocity_y be 0 - upward_force

			let target.airborne be true
			give null

		let opposite be get_element_at(target.position_x - push_direction, target.position_y)

		if opposite equals null:
			let target.position_x be target.position_x - push_direction
			let target.velocity_x be horizontal_transfer - push_direction * outward_force

			if vertical_transfer less_than 0:
				let target.velocity_y be vertical_transfer
			else:
				let target.velocity_y be 0 - upward_force

			let target.airborne be true
			give null

		let upper_side be get_element_at(target.position_x + push_direction, target.position_y - 1)

		if upper_side equals null:
			let target.position_x be target.position_x + push_direction
			let target.position_y be target.position_y - 1
			let target.velocity_x be horizontal_transfer + push_direction * outward_force
			let target.velocity_y be 0 - upward_force
			let target.airborne be true
			give null

		let upper_opposite be get_element_at(target.position_x - push_direction, target.position_y - 1)

		if upper_opposite equals null:
			let target.position_x be target.position_x - push_direction
			let target.position_y be target.position_y - 1
			let target.velocity_x be horizontal_transfer - push_direction * outward_force
			let target.velocity_y be 0 - upward_force
			let target.airborne be true
			give null

		give null

	has function eject_sand_to needs target Sand target_x Number target_y Number direction_x Number direction_y Number:
		let destination be get_element_at(target_x, target_y)

		if not (destination equals null):
			give false

		for_every candidate in get_all_elements():
			if candidate is Square:
				if candidate.is_center:
					if not (candidate.owner equals owner):
						if candidate.is_inside_shape(target_x - candidate.position_x, target_y - candidate.position_y, candidate.rotation):
							give false

		let target.position_x be target_x
		let target.position_y be target_y

		if not (target.position_x equals target_x):
			give false

		if not (target.position_y equals target_y):
			give false

		let target.velocity_x be velocity_x * 0.7 + direction_x * 0.45
		let target.velocity_y be velocity_y * 0.6 + direction_y * 0.45
		let target.airborne be true
		give true

	has function eject_interior_sand:
		go_through 0 to 14 with column:
			go_through 0 to 14 with row:
				let relative_x be column - 7
				let relative_y be row - 7

				if is_inside_shape(relative_x, relative_y, rotation):
					let target be get_element_at(position_x + relative_x, position_y + relative_y)

					if target is Sand:
						let preferred_direction be roll_direction

						if relative_x less_than 0:
							let preferred_direction be 0 - 1
						else if relative_x greater_than 0:
							let preferred_direction be 1

						if eject_sand_to(target, position_x + preferred_direction * 8, target.position_y, preferred_direction, 0):
							do_nothing
						else if eject_sand_to(target, position_x - preferred_direction * 8, target.position_y, 0 - preferred_direction, 0):
							do_nothing
						else if eject_sand_to(target, target.position_x, position_y - 8, 0, 0 - 1):
							do_nothing
						else if eject_sand_to(target, target.position_x, position_y + 8, 0, 1):
							do_nothing
						else if eject_sand_to(target, position_x + preferred_direction * 9, target.position_y, preferred_direction, 0):
							do_nothing
						else:
							do_nothing
					else if target is Water:
						displace_water(target)

	has function repair_water_on_outline:
		let repaired be false

		go_through 0 to 14 with column:
			go_through 0 to 14 with row:
				let relative_x be column - 7
				let relative_y be row - 7

				if is_shape_cell(relative_x, relative_y, rotation):
					let target be get_element_at(position_x + relative_x, position_y + relative_y)

					if target is Water:
						if displace_water(target):
							let repaired be true

		give repaired

	has function handle_collision needs target Element:
		if target is Square:
			collide_with_square(target)
		else if target is Sand:
			displace_sand(target)
		else if target is Water:
			shove(target)
		else if target is Seed:
			shove(target)
		else if target is Fire:
			shove(target)
		else if target is Bird:
			shove(target)
		else if target is FireBird:
			shove(target)

	has function collide_with_square needs other Square:
		if owner equals other.owner:
			give null

		let first_center be find_center()
		let second_center be other.find_center()

		if not (first_center is Square):
			give null

		if not (second_center is Square):
			give null

		let first_center.square_collision be true
		let second_center.square_collision be true

		if first_center.collision_cooldown greater_than 0:
			give null

		if second_center.collision_cooldown greater_than 0:
			give null

		let distance_x be absolute(first_center.position_x - second_center.position_x)
		let distance_y be absolute(first_center.position_y - second_center.position_y)

		let contact_x be other.position_x - first_center.position_x
		let contact_y be other.position_y - first_center.position_y
		let first_spin be first_center.angular_velocity
		let second_spin be second_center.angular_velocity
		let first_center.angular_velocity be first_spin * 0.65 + second_spin * 0.25
		let second_center.angular_velocity be second_spin * 0.65 + first_spin * 0.25

		if distance_x greater_than distance_y:
			let first_incoming be first_center.collision_velocity_x
			let second_incoming be second_center.collision_velocity_x
			let relative_speed be first_incoming - second_incoming
			let first_center.velocity_x be first_incoming * 0.325 + second_incoming * 0.675
			let second_center.velocity_x be first_incoming * 0.675 + second_incoming * 0.325
			let horizontal_torque be contact_y * relative_speed * 0.06
			let first_center.angular_velocity be first_center.angular_velocity + horizontal_torque
			let second_center.angular_velocity be second_center.angular_velocity - horizontal_torque
		else:
			let upper_incoming be first_center.collision_velocity_y
			let lower_incoming be second_center.collision_velocity_y
			let first_is_upper be true

			if first_center.position_y greater_than second_center.position_y:
				let upper_incoming be second_center.collision_velocity_y
				let lower_incoming be first_center.collision_velocity_y
				let first_is_upper be false

			let downward_impact be upper_incoming - lower_incoming

			if downward_impact less_than 0:
				let downward_impact be 0

			let impact_speed be absolute(downward_impact)
			let corner_torque be impact_speed * 0.12 + 0.3

			if first_is_upper:
				let first_center.velocity_y be lower_incoming + downward_impact * 0.28
				let second_center.velocity_y be lower_incoming + downward_impact * 0.72
			else:
				let second_center.velocity_y be lower_incoming + downward_impact * 0.28
				let first_center.velocity_y be lower_incoming + downward_impact * 0.72

			if contact_x greater_than 0.5:
				let first_center.angular_velocity be first_center.angular_velocity - corner_torque
				let first_center.velocity_x be first_center.velocity_x - corner_torque * 0.3
				let second_center.angular_velocity be second_center.angular_velocity + corner_torque * 0.65
			else if contact_x less_than 0 - 0.5:
				let first_center.angular_velocity be first_center.angular_velocity + corner_torque
				let first_center.velocity_x be first_center.velocity_x + corner_torque * 0.3
				let second_center.angular_velocity be second_center.angular_velocity - corner_torque * 0.65

		let first_center.collision_cooldown be 2
		let second_center.collision_cooldown be 2

	has function tick:
		if not initialized:
			let initialized be true
			let owner be get_element_at(position_x, position_y)
			build_shape()
			give null

		if not is_center:
			let orphan_tick be orphan_tick + 1

			if orphan_tick greater_than 10:
				let orphan_tick be 0

				if find_center() equals null:
					disappear()

			give null

		clear_shape()
		eject_interior_sand()

		if collision_cooldown greater_than 0:
			let collision_cooldown be collision_cooldown - 1

		if thunder_cooldown greater_than 0:
			let thunder_cooldown be thunder_cooldown - 1

		let square_collision be false
		let sand_supporting be has_sand_below()
		let collision_velocity_x be velocity_x
		let collision_velocity_y be velocity_y

		let motion_x be motion_x + velocity_x
		let motion_y be motion_y + velocity_y
		let velocity_y be velocity_y + 0.42
		let velocity_x be velocity_x * 0.985

		move_horizontal()
		move_vertical()
		let previous_rotation be rotation
		update_rotation()
		eject_interior_sand()
		build_shape()

		if repair_water_on_outline():
			build_shape()

element Seed is like Kinetic:
	has color with Color(#4caf50)
	has uses_gravity with true
	has started with false

	has function adjacent_water:
		let upper_left be get_element_at(position_x - 1, position_y - 1)
		let above be get_element_at(position_x, position_y - 1)
		let upper_right be get_element_at(position_x + 1, position_y - 1)
		let left be get_element_at(position_x - 1, position_y)
		let right be get_element_at(position_x + 1, position_y)
		let lower_left be get_element_at(position_x - 1, position_y + 1)
		let below be get_element_at(position_x, position_y + 1)
		let lower_right be get_element_at(position_x + 1, position_y + 1)

		if upper_left is Water:
			give upper_left

		if above is Water:
			give above

		if upper_right is Water:
			give upper_right

		if left is Water:
			give left

		if right is Water:
			give right

		if lower_left is Water:
			give lower_left

		if below is Water:
			give below

		if lower_right is Water:
			give lower_right

		give null

	has function tick:
		if apply_velocity():
			give null

		let water be adjacent_water()

		if water is Water:
			if has_sand():
				grow_tree(water)
				give null

		if not started:
			let below be get_element_at(position_x, position_y + 1)

			if below is Thunder:
				below.clear_for_particle()
				let position_y be position_y + 1
				mark_impact(0, 1)
			else if below equals null:
				let position_y be position_y + 1
				mark_impact(0, 1)
			else if below is Water:
				below.convert_to(Seed)
				convert_to(Water)

	has function has_sand:
		let upper_left be get_element_at(position_x - 1, position_y - 1)
		let above be get_element_at(position_x, position_y - 1)
		let upper_right be get_element_at(position_x + 1, position_y - 1)
		let below be get_element_at(position_x, position_y + 1)
		let left be get_element_at(position_x - 1, position_y)
		let right be get_element_at(position_x + 1, position_y)
		let lower_left be get_element_at(position_x - 1, position_y + 1)
		let lower_right be get_element_at(position_x + 1, position_y + 1)

		if upper_left is Sand:
			give true

		if above is Sand:
			give true

		if upper_right is Sand:
			give true

		if below is Sand:
			give true

		if left is Sand:
			give true

		if right is Sand:
			give true

		if lower_left is Sand:
			give true

		if lower_right is Sand:
			give true

		give false

	has function make_first_wood needs water Water:
		let old_up be get_element_at(position_x, position_y - 1)
		let old_down be get_element_at(position_x, position_y + 1)
		let old_left be get_element_at(position_x - 1, position_y)
		let old_right be get_element_at(position_x + 1, position_y)

		spread_element()

		let new_up be get_element_at(position_x, position_y - 1)
		let new_down be get_element_at(position_x, position_y + 1)
		let new_left be get_element_at(position_x - 1, position_y)
		let new_right be get_element_at(position_x + 1, position_y)

		if old_down equals null:
			if new_down is Seed:
				new_down.disappear()

		if old_left equals null:
			if new_left is Seed:
				new_left.disappear()

		if old_right equals null:
			if new_right is Seed:
				new_right.disappear()

		if old_up equals null:
			if new_up is Seed:
				new_up.convert_to(Wood)
				let new_up.root_x be position_x
				let new_up.root_y be position_y
				let new_up.parent_x be position_x
				let new_up.parent_y be position_y
				water.disappear()
				let started be true
				give true
		else if new_up is Water:
			new_up.convert_to(Wood)
			let new_up.root_x be position_x
			let new_up.root_y be position_y
			let new_up.parent_x be position_x
			let new_up.parent_y be position_y
			let started be true
			give true

		give false

	has function grow_tree needs water Water:
		if not started:
			make_first_wood(water)

			give null

		for_every candidate in get_all_elements():
			if candidate is Wood:
				if candidate.root_x equals position_x:
					if candidate.root_y equals position_y:
						if candidate.tip equals true:
							if candidate.connected equals true:
								if candidate.grow(water):
									give null

element Wood is like Kinetic:
	has color with Color(#7a5430)
	has uses_gravity with true
	has root_x with 0
	has root_y with 0
	has parent_x with 0
	has parent_y with 0
	has tip with true
	has connected with true
	has direction with 1
	has horizontal_left with 0
	has vertical_height with 0
	has branch_phase with 0
	has heat with 0

	has function tick:
		if apply_velocity():
			give null

		let parent be get_element_at(parent_x, parent_y)

		if parent is Seed:
			let connected be true
		else if parent is Wood:
			if parent.connected equals true:
				let connected be true
			else:
				let connected be false
		else:
			let connected be false

		if not connected:
			let tip be false

	has function make_child needs child_x Number child_y Number next_horizontal Number next_height Number next_direction Number next_branch Number water Water:
		let old_up be get_element_at(position_x, position_y - 1)
		let old_down be get_element_at(position_x, position_y + 1)
		let old_left be get_element_at(position_x - 1, position_y)
		let old_right be get_element_at(position_x + 1, position_y)
		let old_child be get_element_at(child_x, child_y)

		spread_element()

		let child be get_element_at(child_x, child_y)
		let new_up be get_element_at(position_x, position_y - 1)
		let new_down be get_element_at(position_x, position_y + 1)
		let new_left be get_element_at(position_x - 1, position_y)
		let new_right be get_element_at(position_x + 1, position_y)

		if old_up equals null:
			if new_up is Wood:
				if not (new_up equals child):
					new_up.disappear()

		if old_down equals null:
			if new_down is Wood:
				if not (new_down equals child):
					new_down.disappear()

		if old_left equals null:
			if new_left is Wood:
				if not (new_left equals child):
					new_left.disappear()

		if old_right equals null:
			if new_right is Wood:
				if not (new_right equals child):
					new_right.disappear()

		if child is Water:
			child.convert_to(Wood)

		if child is Wood:
			let child.root_x be root_x
			let child.root_y be root_y
			let child.parent_x be position_x
			let child.parent_y be position_y
			let child.direction be next_direction
			let child.horizontal_left be next_horizontal
			let child.vertical_height be next_height
			let child.branch_phase be next_branch

			if old_child equals null:
				water.disappear()

			give true

		give false

	has function grow needs water Water:
		if not tip:
			give false

		if not connected:
			give false

		if branch_phase equals 1:
			let grew_left be make_child(position_x - 1, position_y, 2, 0, 0 - 1, 0, water)

			if grew_left:
				let branch_phase be 2

			give grew_left

		if branch_phase equals 2:
			let grew_right be make_child(position_x + 1, position_y, 2, 0, 1, 0, water)

			if grew_right:
				let tip be false

			give grew_right

		if horizontal_left greater_than 0:
			let grew_sideways be make_child(position_x + direction, position_y, horizontal_left - 1, vertical_height, direction, 0, water)

			if grew_sideways:
				let tip be false

			give grew_sideways

		let next_height be vertical_height + 1
		let next_branch be 0

		if next_height equals 3:
			let next_height be 0
			let next_branch be 1

		let grew_up be make_child(position_x, position_y - 1, 0, next_height, direction, next_branch, water)

		if grew_up:
			let tip be false

		give grew_up

element BurningWood is like Kinetic:
	has color with Color(#e85d24)
	has uses_gravity with true
	has lifetime with 36
	has emit_tick with 0

	has function emit_fire:
		let old_up be get_element_at(position_x, position_y - 1)
		let old_down be get_element_at(position_x, position_y + 1)
		let old_left be get_element_at(position_x - 1, position_y)
		let old_right be get_element_at(position_x + 1, position_y)

		spread_element()

		let new_up be get_element_at(position_x, position_y - 1)
		let new_down be get_element_at(position_x, position_y + 1)
		let new_left be get_element_at(position_x - 1, position_y)
		let new_right be get_element_at(position_x + 1, position_y)

		if old_up equals null:
			if new_up is BurningWood:
				new_up.convert_to(Fire)

		if old_down equals null:
			if new_down is BurningWood:
				new_down.convert_to(Fire)

		if old_left equals null:
			if new_left is BurningWood:
				new_left.convert_to(Fire)

		if old_right equals null:
			if new_right is BurningWood:
				new_right.convert_to(Fire)

	has function tick:
		if apply_velocity():
			give null

		let lifetime be lifetime - 1

		if lifetime less_than 1:
			convert_to(Smoke)
			give null

		let emit_tick be emit_tick + 1

		if emit_tick equals 5:
			let emit_tick be 0
			emit_fire()

element Bird is like FlockingBird:
	has color with Color(#f4d35e)

	has function ignite_if_touching_fire:
		let above be get_element_at(position_x, position_y - 1)
		let below be get_element_at(position_x, position_y + 1)
		let left be get_element_at(position_x - 1, position_y)
		let right be get_element_at(position_x + 1, position_y)

		if above is Fire:
			above.disappear()
			convert_to(FireBird)
			give true

		if below is Fire:
			below.disappear()
			convert_to(FireBird)
			give true

		if left is Fire:
			left.disappear()
			convert_to(FireBird)
			give true

		if right is Fire:
			right.disappear()
			convert_to(FireBird)
			give true

		give false

	has function tick:
		if ignite_if_touching_fire():
			give null

		move_with_flock()

element FireBird is like FlockingBird:
	has color with Color(#ff2f00)
	has lifetime with 45
	has emit_tick with 0

	has function emit_one_fire:
		let old_down be get_element_at(position_x, position_y + 1)
		let old_up be get_element_at(position_x, position_y - 1)
		let old_left be get_element_at(position_x - 1, position_y)
		let old_right be get_element_at(position_x + 1, position_y)

		spread_element()

		let new_down be get_element_at(position_x, position_y + 1)
		let new_up be get_element_at(position_x, position_y - 1)
		let new_left be get_element_at(position_x - 1, position_y)
		let new_right be get_element_at(position_x + 1, position_y)

		if old_up equals null:
			if new_up is FireBird:
				new_up.disappear()

		if old_left equals null:
			if new_left is FireBird:
				new_left.disappear()

		if old_right equals null:
			if new_right is FireBird:
				new_right.disappear()

		if old_down equals null:
			if new_down is FireBird:
				new_down.convert_to(Fire)

	has function tick:
		let lifetime be lifetime - 1

		if lifetime less_than 1:
			disappear()
			give null

		move_with_flock()
		let emit_tick be emit_tick + 1

		if emit_tick equals 6:
			let emit_tick be 0
			emit_one_fire()

interaction Seed s with Water w:
	if s.has_sand():
		s.grow_tree(w)

interaction Wheel r with Water w:
	r.push_down(w)

interaction Wheel r with Sand s:
	r.push_down(s)

interaction Wheel r with Seed s:
	r.push_down(s)

interaction Wheel r with Smoke s:
	r.push_up(s)

interaction Wheel r with Steam s:
	r.push_up(s)

interaction Wheel r with Fire f:
	r.push_up(f)

interaction Wheel r with Bird b:
	r.push_sideways(b)

interaction Wheel r with FireBird b:
	r.push_sideways(b)

interaction Thunder t with Water w:
	if not w.electrified:
		t.blast(w, 3.5, 5.5)
		let w.electrified be true
		let w.steam_delay be 0

interaction Thunder t with Sand s:
	t.blast(s, 4, 6)

interaction Thunder t with Fire f:
	t.blast(f, 4, 6)

interaction Thunder t with Smoke s:
	t.blast(s, 4, 6)

interaction Thunder t with Steam s:
	t.blast(s, 4, 6)

interaction Thunder t with Wheel w:
	t.blast(w, 3.5, 5.5)

interaction Thunder t with Wood w:
	w.convert_to(BurningWood)
	t.blast(w, 3.5, 5.5)

interaction Thunder t with BurningWood w:
	t.blast(w, 3.5, 5.5)

interaction Thunder t with Seed s:
	s.convert_to(BurningWood)
	t.blast(s, 4, 6)

interaction Thunder t with Bird b:
	b.convert_to(FireBird)
	t.blast(b, 4.5, 6.5)

interaction Thunder t with FireBird b:
	t.blast(b, 4.5, 6.5)

interaction Thunder t with Square s:
	s.struck_by_thunder(t)

interaction Square q with Sand s:
	q.displace_sand(s)

interaction Square q with Water w:
	q.shove(w)

interaction Square q with Seed s:
	q.shove(s)

interaction Square q with Fire f:
	q.shove(f)

interaction Square q with Bird b:
	q.shove(b)

interaction Square q with FireBird b:
	q.shove(b)

interaction Square first with Square second:
	first.collide_with_square(second)

interaction Fire f with Water w:
	w.convert_to(Steam)
	f.disappear()

interaction Fire f with Wood w:
	let w.heat be w.heat + 1

	if w.heat greater_than 3:
		w.convert_to(BurningWood)

interaction Fire f with Seed s:
	s.convert_to(BurningWood)

interaction BurningWood b with Wood w:
	if w.position_y less_than b.position_y:
		let w.heat be w.heat + 1
	else:
		let w.heat be w.heat + 0.25

	if w.heat greater_than 4:
		w.convert_to(BurningWood)

interaction BurningWood b with Water w:
	b.convert_to(Wood)
	w.convert_to(Steam)

interaction Fire f with Bird b:
	b.convert_to(FireBird)
	f.disappear()

interaction FireBird b with Water w:
	b.convert_to(Smoke)
	w.convert_to(Steam)
