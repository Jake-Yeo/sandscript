	has function is_shape_cell needs cell_x Number cell_y Number shape_rotation Number:
		let absolute_x be absolute(cell_x)
		let absolute_y be absolute(cell_y)

		if shape_rotation equals 0:
			if cell_x greater_than 0 - 6:
				if cell_x less_than 6:
