								give false
						else if occupant is Water:
							displace_water(occupant)
							let remaining_occupant be get_element_at(target_x, target_y)

							if not (remaining_occupant equals null):
								give false
						else:
							handle_collision(occupant)

							if occupant is Square:
								if occupant.owner equals owner:
