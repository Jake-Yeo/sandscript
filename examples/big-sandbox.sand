		if center.move_gas_to(target, center.position_x - 8, target.position_y):
			give true

		give center.move_gas_to(target, center.position_x + 8, target.position_y)

	has function can_occupy_shape needs change_x Number change_y Number shape_rotation Number:
		let center_occupant be get_element_at(position_x + change_x, position_y + change_y)

		if not (center_occupant equals null):
			if center_occupant is Thunder:
				center_occupant.clear_for_particle()
			else if center_occupant is Smoke:
