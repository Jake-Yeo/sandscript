		if support is BurningWood:
			give true

		if support is Square:
			give true

		if support is Wheel:
			give true

		give false

	has function roll_on_slope:
		let velocity_x be velocity_x * 0.72
		let angular_velocity be angular_velocity * 0.78
		let support_count be 0
		let support_balance be 0

		if velocity_x greater_than 0 - 0.12:
			if velocity_x less_than 0.12:
				let velocity_x be 0

		if angular_velocity greater_than 0 - 0.04:
			if angular_velocity less_than 0.04:
				let angular_velocity be 0

		go_through 0 to 14 with column:
			go_through 0 to 14 with row:
				let cell_x be column - 7
				let cell_y be row - 7

				if is_shape_cell(cell_x, cell_y, rotation):
					if not is_shape_cell(cell_x, cell_y + 1, rotation):
