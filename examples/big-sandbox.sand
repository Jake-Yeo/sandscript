			bolt.blast(center, 7, 9)
			let center.thunder_cooldown be 4
			let radius_x be position_x - center.position_x
			let radius_y be position_y - center.position_y
			let torque be radius_x * center.velocity_y - radius_y * center.velocity_x
			let center.angular_velocity be center.angular_velocity + torque * 0.025

			if center.angular_velocity greater_than 3:
