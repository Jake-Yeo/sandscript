					else:
						let velocity_x be (0 - velocity_x) * 0.72

					let motion_x be 0
					stop_looping
			else if motion_x less_than 0 - 0.99:
				if can_occupy(0 - 1, 0):
					let position_x be position_x - 1
					let motion_x be motion_x + 1
					let roll_direction be 0 - 1
					let rotation_motion be rotation_motion - 1
				else:
