					give false
			else if center_occupant is Steam:
				if not displace_gas(center_occupant):
					give false
			else if center_occupant is Sand:
				handle_collision(center_occupant)
				let remaining_center_occupant be get_element_at(position_x + change_x, position_y + change_y)

				if not (remaining_center_occupant equals null):
					give false
			else if center_occupant is Water:
