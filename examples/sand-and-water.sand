# Sand & Water
# template_element makes a family.
# "is like" joins it: Sand and Snow are Powders.
# Sand sinks through Water with swap_with.

template_element Powder:
	has function tick:
		let below be get_element_at(position_x, position_y + 1)
		if is_empty(position_x, position_y + 1):
			let position_y be position_y + 1
		else if below is Liquid:
			swap_with(below)
		else:
			let side be random(-1, 1)
			if is_empty(position_x + side, position_y + 1):
				let position_x be position_x + side

template_element Liquid:
	has function tick:
		if is_empty(position_x, position_y + 1):
			let position_y be position_y + 1
		else:
			let position_x be position_x + random(-2, 2)

element Sand is like Powder:
	has color with Color(#e0b25c)

element Snow is like Powder:
	has color with Color(#f4f7fb)

element Water is like Liquid:
	has color with Color(#2f6fd6)

element Stone:
	has color with Color(#7c7f86)
