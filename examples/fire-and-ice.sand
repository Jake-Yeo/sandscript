# Fire & Ice
# Paint Ice, then paint Fire next to it.
# An interaction runs when two elements touch.

element Ice:
	has color with Color(#a5e3f5)

element Fire:
	has color with Color(#ff6a1f)
	has life with 60

	has function tick:
		let life be life - 1
		if life less_than 0:
			convert_to(Smoke)
		else:
			let flame be random(1, 3)
			if flame equals 1:
				let color be Color(#ff5a1a)
			else if flame equals 2:
				let color be Color(#ff9a2a)
			else:
				let color be Color(#ffd24a)
			if chance(10):
				place_element(Smoke, position_x, position_y - 1)
			if chance(30):
				let position_x be position_x + random(-1, 1)
				let position_y be position_y + random(-1, 1)

element Smoke:
	has color with Color(#6b7077)
	has life with 45

	has function tick:
		let life be life - 1
		if life less_than 0:
			disappear()
		else if chance(70):
			let position_y be position_y - 1
			let position_x be position_x + random(-1, 1)

element Water:
	has color with Color(#2f6fd6)

	has function tick:
		if is_empty(position_x, position_y + 1):
			let position_y be position_y + 1
		else:
			let position_x be position_x + random(-1, 1)

element Steam:
	has color with Color(#d7dde3)
	has life with 90

	has function tick:
		let life be life - 1
		if life less_than 0:
			convert_to(Water)
		else:
			let position_y be position_y - 1
			let position_x be position_x + random(-1, 1)

interaction Ice ice with Fire fire:
	if chance(40):
		ice.convert_to(Water)

interaction Water water with Fire fire:
	water.convert_to(Steam)
	if chance(50):
		fire.disappear()
